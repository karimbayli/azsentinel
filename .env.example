# ============================================================
# Sentinel V2 — Environment Variables
# Copy to .env and fill in production values
# ============================================================

# Domain — Caddy uses this for TLS auto-provisioning
# Beta: updown.az  |  Production: netwatch.az
DOMAIN=updown.az

# TimescaleDB credentials
DB_NAME=sentinel
DB_USER=sentinel
DB_PASSWORD=change-me-strong-password

# HMAC shared secret — MUST be identical on central + ALL probe nodes
# Generate with: openssl rand -hex 32
HMAC_SECRET=generate-a-64-char-random-hex-secret-here

# Grafana admin credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-grafana-password

# Telegram Bot (optional — for alerts + social signal)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=0

# Calibration mode — set true for first 7–30 days of operation
CALIBRATION=true

# ── Probe Agent Variables (set per-node) ──
NODE_ID=node-eu
REGION=eu-frankfurt
COUNTRY=DE
CENTRAL_URL=https://updown.az
