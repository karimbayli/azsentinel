# ============================================================
# Sentinel V2 — Central Server Dockerfile
# Multi-stage build: target < 20MB final image
# ============================================================
FROM golang:1.24-alpine AS builder

RUN apk add --no-cache gcc musl-dev sqlite-dev git

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=1 GOOS=linux go build \
    -ldflags="-s -w -X main.version=$(git describe --tags --always 2>/dev/null || echo dev)" \
    -o /sentinel-central ./cmd/central/

# ============================================================
FROM alpine:3.21

RUN apk add --no-cache ca-certificates sqlite-libs tzdata wget && \
    cp /usr/share/zoneinfo/UTC /etc/localtime && \
    adduser -D -H sentinel

COPY --from=builder /sentinel-central /usr/local/bin/sentinel-central
COPY migrations/ /app/migrations/
COPY static/ /app/static/
COPY configs/central.example.yaml /app/configs/central.yaml

WORKDIR /app

RUN chown -R sentinel:sentinel /app

USER sentinel

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget --spider -q http://localhost:8080/healthz || exit 1

ENTRYPOINT ["sentinel-central"]
CMD ["--config", "/app/configs/central.yaml"]
